# Public URL of the deployed site. Netlify injects URL automatically for
# production deploys; set it explicitly for local development so the model can
# be fetched from the site CDN.
# APP_URL="https://nilgpt.netlify.app"

# Optional: restrict browser origins that may call the API (comma separated).
# The deployed origin is always allowed.
# CORS_ORIGINS="https://example.com"

# Optional: override the on-disk location of the GGUF model.
# WEBGPT_MODEL_PATH="/tmp/webgpt/models/Falcon-H1-Tiny-Multilingual-100M-Instruct.Q4_K_M.gguf"

# Optional: override the location of the bundled llama.cpp runtime.
# WEBGPT_LLAMA_DIR="/var/task/runtime/llama"

# Optional: override the writable cache directory used for the model and the
# runtime inside the execution environment.
# WEBGPT_CACHE_DIR="/tmp/webgpt"

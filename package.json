{
  "name": "webgpt",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/prepare-model.mjs",
    "build:app": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "pretest": "node scripts/prepare-model.mjs --out .cache/webgpt/models",
    "test": "tsx --test tests/*.test.ts",
    "clean": "rm -rf dist .cache",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@netlify/functions": "^6.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-react": "^6.1.1",
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.546.0",
    "marked": "^18.2.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
